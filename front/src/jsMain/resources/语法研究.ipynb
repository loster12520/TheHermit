   "source": [
    "class UniqueEntity {\n",
    "    companion object {\n",
    "        private var idCounter = 0\n",
    "    }\n",
    "\n",
    "    val id: Int by lazy { idCounter++ }\n",
    "    val uuid: String by lazy { id.toString(36) }\n",
    "}\n",
    "\n",
    "(0..100).map {\n",
    "    UniqueEntity()\n",
    "}.map {\n",
    "    it.uuid\n",
    "}"
   ],
